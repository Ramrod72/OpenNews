# Copy this file to .env and fill in real values before running the app.
# See DEPLOYMENT.md for the full walkthrough.

# --- Site URL ---
# The public origin Veriqen is served from (no trailing slash needed —
# it's normalized either way). Used to build canonical links, Open
# Graph/Twitter card metadata, and share URLs. Not required for local
# development: without it, these fall back to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# --- Database ---
# SQLite (default, zero-config):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production alternative — also requires changing `provider` in
# prisma/schema.prisma to "postgresql"):
# DATABASE_URL="postgresql://user:password@localhost:5432/opennews"

# --- Admin authentication ---
# Required for the admin panel session cookie to work. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=""

# Preferred: a bcrypt hash of your admin password. Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" "your-password-here"
ADMIN_PASSWORD_HASH=""
# Alternative for local development ONLY (plaintext, logged as a warning in
# production if used instead of ADMIN_PASSWORD_HASH):
# ADMIN_PASSWORD="change-me"

# --- Optional AI (story summaries work without this via extractive fallback) ---
# "none" (default) or "ollama"
AI_PROVIDER="none"
AI_BASE_URL="http://localhost:11434"
AI_MODEL="llama3.1"

# --- Stripe billing (optional — the app runs fine with none of this set;
# Basic/Pro checkout, the Customer Portal, and the billing webhook are all
# simply unavailable until every one of these is set and consistent) ---
# "test" or "live" — must match STRIPE_SECRET_KEY's own sk_test_/sk_live_
# (or rk_test_/rk_live_) prefix, or billing is disabled entirely rather
# than guessing which mode was intended. See ARCHITECTURE.md's Phase 12B
# section for why this is never inferred from a Price id or the webhook
# secret, neither of which Stripe documents a mode-indicating format for.
# STRIPE_MODE="test"
# STRIPE_SECRET_KEY="sk_test_..."
# From the webhook endpoint's settings in the Stripe Dashboard, once you've
# pointed it at https://your-domain.example/api/billing/webhook:
# STRIPE_WEBHOOK_SECRET="whsec_..."
# The Stripe Price ids for the Basic ($4.99/mo) and Pro ($9.99/mo) plans —
# create these as recurring monthly Prices in the Stripe Dashboard first.
# STRIPE_BASIC_PRICE_ID="price_..."
# STRIPE_PRO_PRICE_ID="price_..."

# --- Worker ---
# Cron expression the worker uses to check for due feeds (default: every 5 minutes).
WORKER_CRON="*/5 * * * *"
# Custom User-Agent sent when fetching feeds (identify yourself to publishers).
# INGEST_USER_AGENT="OpenNewsBot/1.0 (+https://your-deployment.example.com)"
