// Veriqen database schema
//
// Default datasource is SQLite for zero-config local/self-hosted use.
// To run on PostgreSQL for production: change `provider` below to
// "postgresql" and point DATABASE_URL at your Postgres instance, then
// run `npx prisma migrate deploy`. The schema intentionally avoids
// SQLite-only types so it works unchanged on both. See DEPLOYMENT.md.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// A configured news feed (RSS/Atom) that the ingestion worker polls.
/// Phase 6 adds an optional publisher-profile layer (description through
/// profileUpdatedAt below) on top of the existing ingestion fields — every
/// added column is nullable so a Source created by feed ingestion alone,
/// with no profile ever filled in, remains fully valid. See ARCHITECTURE.md
/// for the source-profile vs. external-assessment distinction.
model Source {
  id                   String    @id @default(cuid())
  name                 String
  /// Feed URL (RSS/Atom endpoint)
  url                  String    @unique
  /// Public homepage of the publisher, used for attribution links AND as
  /// the profile's "Website" field — deliberately not a separate column.
  homepageUrl          String?
  /// Default category slug applied to articles from this source
  categorySlug         String
  /// Publisher logo/wordmark, also used as the profile's image.
  logoUrl              String?
  active               Boolean   @default(true)
  fetchIntervalMinutes Int       @default(30)
  lastFetchedAt        DateTime?
  lastSuccessAt        DateTime?
  lastErrorAt          DateTime?
  lastError            String?
  consecutiveFailures  Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  /// Plain-text (HTML stripped on write) description of the publisher.
  description      String?
  /// One of SOURCE_TYPE_VALUES (src/lib/validation/sourceProfile.ts) — a
  /// plain String, not a Prisma enum, for the same Postgres-portability
  /// reason every other closed value set in this schema is a validated
  /// String (see Subscription.status).
  sourceType       String?
  /// Free-text country name — deliberately not an ISO-code lookup table;
  /// nothing currently needs to query/filter by it.
  country          String?
  /// Parent company / owning organization, free text.
  ownership        String?
  foundedYear      Int?
  /// When an admin last edited the profile fields above. Deliberately
  /// separate from the row's own `updatedAt`, which also changes on every
  /// routine ingestion fetch and so can't answer "when was this profile
  /// last reviewed."
  profileUpdatedAt DateTime?

  articles            Article[]
  fetchLogs           FeedFetchLog[]
  externalAssessments ExternalAssessment[]
  /// Optional back-relation for ProvenanceEntity.relatedSourceId (Phase 7B)
  /// — a Source never requires a linked entity, this is read-only convenience.
  provenanceEntities  ProvenanceEntity[]

  @@index([active])
}

/// A third party's published assessment of a Source — e.g. a political-lean
/// or factuality rating — always attributed to the organization that made
/// it. Veriqen never derives or averages these; see ARCHITECTURE.md. One
/// Source can have many assessments across providers and types, and the
/// same provider/type pair isn't unique: a provider's rating can be
/// recorded more than once over time without overwriting history.
model ExternalAssessment {
  id       String @id @default(cuid())
  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  /// The organization that produced this assessment, e.g. "Example Rating
  /// Institute" (plain text; never invented or copied from a real rating
  /// service without a licensing decision — see SECURITY.md).
  provider       String
  /// One of ASSESSMENT_TYPE_VALUES (src/lib/validation/sourceProfile.ts),
  /// e.g. "political_lean", "factuality" — same String-not-enum reasoning
  /// as Source.sourceType.
  assessmentType String
  /// The rating itself, in the provider's own words (e.g. "Left-Center",
  /// "High factual reporting") — free text on purpose. Different
  /// providers use incompatible scales; Veriqen never converts these to a
  /// shared numeric score.
  ratingValue    String
  /// Optional description of the provider's own scale, e.g. "Left /
  /// Left-Center / Center / Right-Center / Right".
  ratingScale    String?
  /// Where this assessment can be independently verified.
  referenceUrl   String?
  /// When the provider published/last updated this assessment, if known.
  assessedAt     DateTime?
  /// When Veriqen recorded this assessment — distinct from assessedAt.
  retrievedAt    DateTime  @default(now())
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceId])
  @@index([provider])
  @@index([assessmentType])
}

/// A news topic/section (World, Business, Technology, ...)
model Category {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  order Int    @default(0)

  articles   Article[]
  clusters   StoryCluster[]
  userTopics UserTopic[]
}

/// A single article/item pulled from a source feed.
model Article {
  id              String    @id @default(cuid())
  sourceId        String
  source          Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  url             String    @unique
  /// SHA-256 of the normalized URL, used for fast dedupe lookups
  urlHash         String    @unique
  title           String
  /// Lowercased, punctuation-stripped title used for similarity comparisons
  titleNormalized String
  /// Short excerpt/description as provided by the feed (sanitized, plain text)
  excerpt         String?
  imageUrl        String?
  author          String?
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  publishedAt     DateTime
  fetchedAt       DateTime  @default(now())
  guid            String?

  clusterId String?
  cluster   StoryCluster? @relation(fields: [clusterId], references: [id])

  keywords               ArticleKeyword[]
  /// Structured attribution evidence extracted from this article's text
  /// (Phase 7B) — see ProvenanceObservation.
  provenanceObservations ProvenanceObservation[]
  /// Deterministic numerical/attributed-statement claims extracted from
  /// this article's text (Phase 10B) — see Claim.
  claims                 Claim[]

  createdAt DateTime @default(now())

  @@index([publishedAt])
  @@index([clusterId])
  @@index([categoryId])
  @@index([titleNormalized])
}

/// A group of articles from different sources believed to cover the same
/// underlying event ("story"). Produced by the clustering engine.
model StoryCluster {
  id            String    @id @default(cuid())
  /// Representative headline shown on cards (from the earliest article)
  headline      String
  slug          String    @unique
  /// Auto-generated extractive (or optional AI) summary. Never fabricated.
  summary       String?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  sourceCount   Int       @default(0)
  articleCount  Int       @default(0)
  firstSeenAt   DateTime
  lastUpdatedAt DateTime
  breaking      Boolean   @default(false)
  breakingScore Float     @default(0)
  imageUrl      String?

  articles     Article[]
  keywords     ClusterKeyword[]
  savedByUsers SavedStory[]
  /// Phase 11B validated AI Story Brief artifacts — see AiStoryBrief's own
  /// doc comment for why this is separate from `summary` above.
  aiStoryBriefs AiStoryBrief[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastUpdatedAt])
  @@index([breaking])
  @@index([categoryId])
}

/// A topic/entity keyword extracted from articles, used for search & clustering.
model Keyword {
  id   String @id @default(cuid())
  term String @unique

  articles   ArticleKeyword[]
  clusters   ClusterKeyword[]
  userTopics UserTopic[]
}

model ArticleKeyword {
  articleId String
  keywordId String
  weight    Float  @default(1)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([articleId, keywordId])
}

model ClusterKeyword {
  clusterId String
  keywordId String
  weight    Float  @default(1)

  cluster StoryCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  keyword Keyword      @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([clusterId, keywordId])
}

/// Health/audit log for each feed fetch attempt (for admin diagnostics).
model FeedFetchLog {
  id           String    @id @default(cuid())
  sourceId     String
  source       Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  success      Boolean
  itemsFound   Int       @default(0)
  itemsNew     Int       @default(0)
  errorMessage String?

  @@index([sourceId, startedAt])
}

/// Runtime-configurable application settings (ad slots, AI provider, etc.)
/// managed from the admin panel and persisted so they survive restarts.
model AdminSetting {
  key       String   @id
  /// JSON-encoded value
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Consumer accounts + subscriptions (Veriqen Phase 2)
//
// Deliberately separate from the single shared admin credential above
// (AdminSetting, src/lib/auth/session.ts): these models back real per-user
// accounts for the public product, with their own session mechanism. No
// existing model's columns are altered by this section — Category,
// Keyword, and StoryCluster above only gained new *opposite* relation
// fields (userTopics / savedByUsers), which Prisma resolves via the foreign
// key living on the new child tables below, so migrating this in adds
// tables only and never touches Article/Source/Category/Keyword/
// StoryCluster/FeedFetchLog/AdminSetting's own columns.
//
// Status-like fields (Subscription.status, Plan.billingInterval) are kept
// as plain `String` rather than Prisma `enum`, matching the rest of this
// schema: Prisma enums aren't supported on the sqlite connector, and this
// schema is written to run unchanged on SQLite or Postgres.
// ---------------------------------------------------------------------------

/// A registered end-user account (distinct from the single admin credential).
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  /// bcrypt hash — never plaintext, never sent to client JS.
  passwordHash       String
  displayName        String?
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  /// Billing-provider customer id (e.g. a Stripe customer id). Lives here
  /// rather than on Subscription: a billing-provider customer is 1:1 with
  /// the account and commonly exists before any subscription does (a saved
  /// payment method, a trial), and a webhook's most common lookup is
  /// "find the user for this customer id" — a direct unique lookup here,
  /// rather than joining through subscription history to guess the
  /// current row. Unset until a billing provider is configured (Phase 12).
  externalCustomerId String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions               AuthSession[]
  subscriptions          Subscription[]
  savedStories           SavedStory[]
  topics                 UserTopic[]
  usageRecords           UsageRecord[]
  notificationPreference NotificationPreference?
  checkoutIntent         CheckoutIntent?
}

/// A consumer login session. Unlike the admin's stateless signed cookie,
/// this is DB-backed so sessions can be listed/revoked (e.g. "log out
/// everywhere", account deletion). Only a SHA-256 hash of the session
/// token is stored; the raw token lives solely in the browser's httpOnly
/// cookie, so a database read alone can never authenticate as the user.
model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

/// A subscription tier (Free / Basic / Pro). A real table, not a hardcoded
/// enum, so pricing/plans can change without an application redeploy.
model Plan {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  priceCents      Int      @default(0)
  /// Billing cadence, e.g. "month". Free plans use this as a nominal value.
  billingInterval String   @default("month")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entitlements  Entitlement[]
  subscriptions Subscription[]
}

/// A single feature flag/quota attached to a plan. This is the centralized
/// entitlement system: application code should look up
/// `Entitlement` rows by (plan, feature) rather than scattering
/// `if (user.plan === "PRO")` checks throughout the codebase (the feature
/// lookup helper itself lands in Phase 3).
model Entitlement {
  id         String   @id @default(cuid())
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Stable feature key, e.g. "ads_enabled", "saved_stories_limit".
  feature    String
  /// Set for boolean on/off features.
  boolValue  Boolean?
  /// Set for numeric quotas; null means unlimited.
  limitValue Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([planId, feature])
}

/// A user's subscription to a plan over time. Every user — including
/// free users — has exactly ONE Subscription row (to plan "free" until
/// they ever pay) so "what plan is this user on" is always a single
/// consistent lookup rather than a nullable special case. Phase 12B
/// preserves this invariant: a plan/billing change UPDATES this row in
/// place — it never inserts a second row for the same user (see
/// src/lib/billing/webhookSync.ts).
///
/// `status` holds Stripe's own subscription-status string verbatim once
/// `billingProvider = "stripe"` ("active" | "past_due" | "unpaid" |
/// "canceled" | "incomplete" | "incomplete_expired" | "trialing" |
/// "paused") — never re-encoded into a separate Veriqen-specific enum.
/// Which of these statuses currently grant PAID entitlements is decided
/// in exactly one place (src/lib/entitlements.ts's `grantsPaidAccess`),
/// not here and not by application code elsewhere — `planId` on this row
/// simply records which plan the subscription is FOR (kept even after
/// cancellation, as a historical record) while `status` is what gates
/// access. A plan-mapped `Entitlement` for the free plan is unaffected by
/// any of this, since the free plan needs no such gating in the first
/// place.
model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan      @relation(fields: [planId], references: [id])
  /// "active" | "canceled" | "past_due" | "unpaid" | "trialing" |
  /// "incomplete" | "incomplete_expired" | "paused" (Stripe's own status
  /// vocabulary, once billingProvider = "stripe") — see this model's own
  /// doc comment above.
  status                 String    @default("active")
  /// e.g. "stripe"; null until a billing provider is configured (Phase 12).
  billingProvider        String?
  /// The billing-provider subscription object id (1:1 with this row,
  /// unlike the customer id — see User.externalCustomerId). Unique so a
  /// given Stripe subscription can never be mapped to two local rows.
  externalSubscriptionId String?   @unique
  /// The specific Stripe Price id currently active on this subscription —
  /// recorded separately from `planId` (which is Veriqen's own resolved
  /// plan) so support/ops can see exactly what Stripe considers active
  /// without a second API call, and so a price unrecognized by the
  /// trusted plan mapping is visibly distinguishable from one that is.
  externalPriceId        String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  /// When this row was last overwritten by a verified webhook sync — never
  /// set by anything else. Absence (null) on a paid-looking row is itself
  /// a signal worth surfacing to support: it means Stripe is the one
  /// source that has never actually confirmed this row's state.
  lastSyncedAt           DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

/// Pre-merge concurrency hardening (Phase 12B follow-up) — closes the race
/// where two concurrent first-purchase requests for the same user could
/// each create their own real Stripe Checkout Session before either
/// completed, risking two simultaneous paid subscriptions. Exactly ONE row
/// per user (`userId` is `@unique`), mirroring Subscription's own
/// one-row-per-user invariant — a fresh attempt UPDATES this row in place
/// rather than inserting a second one. See src/lib/billing/checkoutIntent.ts
/// for reserveOrReuseCheckoutIntent(), the only writer of this table, and
/// its own doc comment for the full concurrency argument (why the DB's
/// unique constraint, not just an application-level check, is the actual
/// enforcement point under Postgres's MVCC, and why the derived Stripe
/// idempotency key is scoped to one attempt rather than to the user+plan
/// forever).
model CheckoutIntent {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The plan slug this attempt is for — a second concurrent attempt for a
  /// DIFFERENT plan while this one is still pending is rejected outright
  /// (never silently switched), so a user can't have two in-flight
  /// attempts for different plans racing each other.
  planSlug String

  /// "pending" | "completed" | "abandoned". Only "pending" rows are ever
  /// reused/extended in place; any other value (or an expired "pending"
  /// row) is eligible to be atomically overwritten by a fresh attempt.
  status String @default("pending")

  /// The real Stripe Checkout Session id, once created — stored for
  /// reconciliation/debugging only; never re-derived from client input.
  externalCheckoutSessionId String?

  /// Refreshed every time this row is reused for a genuinely NEW attempt
  /// (as opposed to a retry of the SAME attempt) — this is what makes the
  /// derived Stripe idempotency key change on a new attempt while staying
  /// stable across retries of one attempt. See checkoutIntent.ts.
  createdAt DateTime @default(now())

  /// A "pending" row past this time is treated as abandoned and is free to
  /// be reused by a fresh attempt — this is what guarantees a user is
  /// never permanently blocked from retrying.
  expiresAt DateTime
}

/// Records that a given Stripe webhook event has been fully, successfully
/// synchronized locally — the ONE mechanism that makes webhook processing
/// idempotent against Stripe's at-least-once, possibly-out-of-order
/// delivery. A row here is written ONLY inside the same database
/// transaction as the Subscription write it corresponds to (see
/// src/lib/billing/webhookSync.ts) — if that transaction rolls back for
/// any reason, this row is never created either, so Stripe's retry of the
/// same event is free to try the whole synchronization again from
/// scratch. There is deliberately no relation to User/Subscription: the
/// Stripe event id alone is sufficient for deduplication, and correlating
/// an event to a user is only ever needed transiently during processing.
model ProcessedWebhookEvent {
  /// The Stripe event id itself (e.g. "evt_..."), not a generated cuid —
  /// this is what makes a duplicate/replayed delivery of the exact same
  /// event a guaranteed, trivial primary-key conflict rather than
  /// something application code has to reason about.
  id          String   @id
  /// e.g. "customer.subscription.updated" — observability only, never
  /// branched on by anything that needs to be a security boundary (that
  /// branching happens once, before this row is ever written).
  type        String
  processedAt DateTime @default(now())
}

/// Tracks consumption of quota-limited features (e.g. Pro AI operations)
/// per user per billing/usage period, so expensive operations can be
/// rate-limited against Entitlement.limitValue.
model UsageRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature     String
  periodStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([userId, feature, periodStart])
}

/// A story a user has bookmarked to their account (server-side; distinct
/// from the anonymous, localStorage-only bookmarks the public site already
/// supports — see src/lib/hooks/usePersonalization.ts).
model SavedStory {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clusterId String
  cluster   StoryCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, clusterId])
}

/// A topic a user follows: an existing Category, an extracted Keyword, or
/// a free-text label if neither applies. If the referenced Category/Keyword
/// is later removed, the row survives (FK set null) rather than vanishing,
/// since `label` can stand alone as the user-facing description.
model UserTopic {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  keywordId  String?
  keyword    Keyword?  @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  label      String?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Provenance extraction foundation (Veriqen Phase 7B)
//
// Structured, per-article evidence of WHERE an article's text says its
// information came from (a wire service, a government statement, a court
// filing, ...) — deliberately NOT a source graph, an independence count, or
// a reliability score. Phase 8 consumes these rows to reason across
// articles/clusters; Phase 7B only produces them. See ARCHITECTURE.md.
//
// ProvenanceEntity is intentionally separate from Source: Source is a
// configured feed Veriqen actively polls, while a ProvenanceEntity is
// something *mentioned inside article text* (Reuters, the FBI, a court)
// that usually has no feed of its own. relatedSourceId is an optional,
// one-directional convenience cross-reference only — never required, and
// Source never gains a reciprocal required link back.
//
// Every value-set field below (entityType, relationshipType, evidenceType,
// confidence, extractionSource, matchType, source, reviewState) is a plain
// validated String, not a Prisma enum — the same Postgres/SQLite-portability
// convention already used throughout this schema (see Subscription.status).
// Valid values live in src/lib/validation/provenance.ts.
// ---------------------------------------------------------------------------

/// An entity a piece of reporting cites or attributes information to —
/// e.g. Reuters, the Associated Press, the DOJ, the FBI, a named
/// individual, or an anonymous-source concept. Not a configured feed (see
/// Source) and not created merely because a name is mentioned somewhere —
/// only when the deterministic extractor resolves a raw attribution match
/// against a known alias (src/lib/provenance/entityResolution.ts).
model ProvenanceEntity {
  id            String  @id @default(cuid())
  /// Unique so seeding (config/provenanceAliases.json) is a plain
  /// idempotent upsert-by-name — also prevents accidentally creating two
  /// separate "Reuters" rows in the first place, rather than relying only
  /// on mergedIntoId to clean up after the fact.
  canonicalName String  @unique
  /// One of PROVENANCE_ENTITY_TYPE_VALUES.
  entityType    String
  /// e.g. "reuters.com" — optional, never required, never used for lookups yet.
  primaryDomain String?

  /// Optional convenience cross-reference to an existing Source when this
  /// entity also happens to be a configured feed (e.g. "the Guardian").
  /// Nullable and one-directional: Source never links back.
  relatedSourceId String?
  relatedSource   Source? @relation(fields: [relatedSourceId], references: [id], onDelete: SetNull)

  /// Future-safe merge foundation only (e.g. resolving a duplicate "DOJ"
  /// entity into the canonical one) — no merge UI/logic in Phase 7B.
  /// Self-referential and nullable; never destructively deleted.
  mergedIntoId String?
  mergedInto   ProvenanceEntity?  @relation("ProvenanceEntityMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   ProvenanceEntity[] @relation("ProvenanceEntityMerge")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases      ProvenanceAlias[]
  observations ProvenanceObservation[]
  /// Phase 10B ATTRIBUTED_STATEMENT claims resolved to this entity.
  claims       Claim[]

  @@index([relatedSourceId])
  @@index([mergedIntoId])
  @@index([entityType])
}

/// A known surface form of a ProvenanceEntity's name ("Reuters News",
/// "Thomson Reuters", "AP", "DOJ", ...), used to resolve a raw matched
/// string from article text to a canonical entity. Deterministic only —
/// no fuzzy matching in Phase 7B.
model ProvenanceAlias {
  id       String           @id @default(cuid())
  entityId String
  entity   ProvenanceEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  /// The alias exactly as it should be recognized/displayed.
  aliasText       String
  /// Lowercased/trimmed form of aliasText — SQLite doesn't support
  /// Prisma's `mode: "insensitive"` (see ARCHITECTURE.md's Search section
  /// for the same limitation elsewhere in this app), so CASE_INSENSITIVE
  /// resolution compares against this column in application code rather
  /// than relying on a DB-level case-insensitive query.
  normalizedAlias String

  /// One of PROVENANCE_ALIAS_MATCH_TYPE_VALUES. EXACT for short, ambiguous
  /// tokens (e.g. "AP" — must appear exactly as two capital letters, never
  /// matched against "ap" lowercased inside another word); CASE_INSENSITIVE
  /// for unambiguous full names ("Reuters", "Associated Press").
  matchType String
  /// One of PROVENANCE_ALIAS_SOURCE_VALUES. SEED rows ship with the app;
  /// ADMIN_OVERRIDE rows must never be touched by reprocessing.
  source    String

  createdAt DateTime @default(now())

  @@unique([normalizedAlias])
  @@index([entityId])
}

/// One structured piece of evidence: "this article's text appears to
/// attribute information to this entity, in this way, with this evidence
/// snippet." Never an aggregate, never a confirmation count, never a
/// reliability score — see ARCHITECTURE.md's Phase 7 section for the exact
/// boundary with Phase 8.
model ProvenanceObservation {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  /// Nullable — resolution against a known alias frequently won't succeed;
  /// rawEntityText is always populated regardless so nothing is ever lost.
  entityId      String?
  entity        ProvenanceEntity? @relation(fields: [entityId], references: [id], onDelete: SetNull)
  rawEntityText String

  /// One of PROVENANCE_RELATIONSHIP_TYPE_VALUES.
  relationshipType String
  /// One of PROVENANCE_EVIDENCE_TYPE_VALUES. Describes reporting distance /
  /// evidence form ONLY — never a claim that the underlying facts are true
  /// (a government statement is primary evidence of what the government
  /// SAID, not proof of what it said being correct). See
  /// src/lib/provenance/patterns.ts for the full policy note.
  evidenceType     String
  /// One of PERSISTABLE_CONFIDENCE_VALUES (HIGH | MEDIUM) ONLY. The
  /// extractor's own output type also allows LOW, but Phase 7B's locked
  /// precision policy — false negative over false positive — means
  /// persistObservations() filters LOW out before any row reaches this
  /// table. A LOW value here would itself be a bug; regression-tested in
  /// test/provenanceExtraction.test.ts.
  confidence       String

  /// The smallest span of text that shows the actual attribution
  /// construction (e.g. "According to a DOJ press release,") — never the
  /// entire excerpt/feed text, and bounded to a sensible maximum length
  /// (see src/lib/provenance/persistObservations.ts).
  evidenceText String

  /// One of PROVENANCE_EXTRACTION_SOURCE_VALUES — which text buffer
  /// startOffset/endOffset index into. FEED_TEXT is only ever produced for
  /// newly-ingested articles, at ingestion time, against fuller sanitized
  /// feed text that is NEVER itself persisted anywhere (see
  /// src/lib/ingest/ingestSource.ts) — evidenceText is the only surviving
  /// trace of it. Historical backfill can only ever produce TITLE or
  /// STORED_EXCERPT_BACKFILL, since the fuller text no longer exists for
  /// old articles.
  extractionSource String
  startOffset      Int
  endOffset        Int

  /// e.g. "attribution-regex@1" — bumped whenever extraction logic changes
  /// meaningfully. Reprocessing replaces stale extractor-generated rows for
  /// an article but must never touch an ADMIN_OVERRIDE row (reviewState).
  extractorVersion String

  /// One of PROVENANCE_REVIEW_STATE_VALUES. Foundation for future manual
  /// correction only — no admin UI reads or writes this in Phase 7B beyond
  /// this column existing so a later phase doesn't need a migration to add it.
  reviewState String @default("UNREVIEWED")

  /// SHA-256 of the fields that make an observation "the same one" —
  /// (articleId, extractorVersion, extractionSource, startOffset,
  /// endOffset, relationshipType, rawEntityText) — computed in
  /// persistObservations.ts. Makes repeated worker/backfill runs safely
  /// idempotent via the same unique-constraint-race pattern
  /// Article.urlHash already establishes (see src/lib/ingest/ingestSource.ts).
  dedupeKey String @unique

  createdAt DateTime @default(now())

  @@index([articleId])
  @@index([entityId])
  @@index([extractorVersion])
  @@index([reviewState])
}

/// Phase 10B — a single, bounded, deterministically-extracted claim from
/// one article's text: either a NUMERICAL_ASSERTION (a number tied to a
/// closed-set recognized unit, e.g. "12 people were injured") or an
/// ATTRIBUTED_STATEMENT (the sentence containing an existing, already-
/// persisted Phase 7 ProvenanceObservation — see
/// src/lib/claims/buildAttributedStatementClaims.ts's own doc comment on
/// why ATTRIBUTED_STATEMENT is never independently re-derived). Like
/// ProvenanceObservation, this is one atomic, per-article, traceable fact
/// — never an aggregate, never a cross-article group, never a truth/
/// confidence score about the claim's content. Cross-article grouping
/// happens entirely at query time (src/lib/claims/buildClaimGroups.ts) —
/// no ClaimGroup/ClaimOccurrence table exists, by design (see
/// ARCHITECTURE.md's Phase 10B section for the full rationale, which
/// mirrors Phase 8's own ProvenanceObservation-persisted /
/// SharedReportingSourceGroup-unpersisted split exactly).
model Claim {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  /// One of CLAIM_KIND_VALUES (NUMERICAL_ASSERTION | ATTRIBUTED_STATEMENT).
  kind String

  /// The bounded sentence-level snippet the claim was derived from — never
  /// the full input text (see src/lib/claims/persistClaims.ts for the
  /// enforced length cap). This is the ONLY text ever shown to a consumer
  /// for this claim.
  rawText String
  /// Deterministic, conservative normalization of rawText used ONLY for
  /// query-time grouping-similarity comparison (src/lib/claims/normalize.ts)
  /// — never itself displayed.
  normalizedText String

  /// Nullable — NUMERICAL_ASSERTION claims usually have none, and an
  /// ATTRIBUTED_STATEMENT's underlying Phase 7 observation frequently
  /// won't resolve either (see ProvenanceObservation.entityId's own
  /// comment). Never fabricated when unresolved.
  entityId String?
  entity   ProvenanceEntity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  /// Present only for kind = NUMERICAL_ASSERTION.
  numericValue Float?
  /// One of CLAIM_NUMERIC_UNIT_VALUES — closed set. Present only for kind = NUMERICAL_ASSERTION.
  numericUnit  String?
  /// One of CLAIM_NUMERIC_QUALIFIER_VALUES — EXACT/AT_LEAST/MORE_THAN/
  /// AT_MOST/LESS_THAN/APPROXIMATE. Present only for kind = NUMERICAL_ASSERTION;
  /// grouping must never treat two different qualifiers as equivalent.
  numericQualifier String?

  /// One of PROVENANCE_EXTRACTION_SOURCE_VALUES — reused verbatim from
  /// Phase 7 so the two modules can never silently disagree on what
  /// TITLE/FEED_TEXT/STORED_EXCERPT_BACKFILL mean. Historical backfill can
  /// only ever produce TITLE or STORED_EXCERPT_BACKFILL claims — never
  /// FEED_TEXT, honestly reflecting what text was actually available (see
  /// worker/backfill-claims.ts).
  extractionSource String
  startOffset      Int
  endOffset        Int

  /// One of PERSISTABLE_CONFIDENCE_VALUES (HIGH | MEDIUM) ONLY — reused
  /// verbatim from Phase 7's confidence concept. A LOW value here would
  /// itself be a bug; persistClaims.ts never produces one, since
  /// src/lib/claims/extractNumericalAssertions.ts and
  /// buildAttributedStatementClaims.ts never emit LOW to begin with.
  confidence String

  /// e.g. "claim-regex@1" — bumped whenever extraction logic changes
  /// meaningfully. Reprocessing replaces stale extractor-generated rows for
  /// an article but must never touch an ADMIN_OVERRIDE row (reviewState).
  claimExtractorVersion String

  /// One of PROVENANCE_REVIEW_STATE_VALUES — reused verbatim. Foundation
  /// for future manual correction only; no admin UI reads or writes this
  /// in Phase 10B beyond this column existing.
  reviewState String @default("UNREVIEWED")

  /// SHA-256 of the fields that make a claim "the same one" — (articleId,
  /// claimExtractorVersion, extractionSource, kind, startOffset, endOffset,
  /// entityId, numericUnit, numericQualifier) — computed in
  /// persistClaims.ts. Makes repeated worker/backfill runs safely
  /// idempotent, the same unique-constraint-race pattern
  /// ProvenanceObservation.dedupeKey already establishes.
  dedupeKey String @unique

  createdAt DateTime @default(now())

  @@index([articleId])
  @@index([kind])
  @@index([claimExtractorVersion])
  @@index([entityId])
}

/// Phase 11B — one validated, AI-generated "Story Brief" artifact for one
/// StoryCluster. This is deliberately separate from the pre-existing
/// `StoryCluster.summary` (an unrelated, ungated, batch-generated
/// extractive/Ollama summary from Phase "Optional AI module" — see
/// ARCHITECTURE.md's Phase 11B section for the exact distinction): that
/// older field is untouched by this phase.
///
/// A row here is only ever created AFTER the model's raw output has
/// passed the full validation pipeline (schema, length/array caps,
/// reference-set validation, forbidden-language check) — see
/// src/lib/ai/storyBrief/generate.ts. This table doubles as the cache: a
/// request first looks for an existing row matching the exact
/// (storyClusterId, feature, inputFingerprint, promptVersion, provider,
/// model) tuple before ever calling a provider again.
///
/// Never stores raw article/feed text, a user identity, or a provider API
/// key — only the already-validated, already-consumer-safe generated
/// output plus the version metadata needed to know when to regenerate.
model AiStoryBrief {
  id             String       @id @default(cuid())
  storyClusterId String
  storyCluster   StoryCluster @relation(fields: [storyClusterId], references: [id], onDelete: Cascade)

  /// Stable feature key, e.g. "ai_story_brief" — future-proofs this table
  /// for a later, distinct AI feature without a new table.
  feature String

  /// SHA-256 of the exact bounded structured input the model saw (see
  /// src/lib/ai/storyBrief/fingerprint.ts) — changes whenever the
  /// underlying claim groups, source overlap, or headline comparison
  /// change, which is what naturally invalidates this cache entry.
  inputFingerprint String

  /// Bumped whenever the prompt/instructions change meaningfully.
  promptVersion String
  /// e.g. "ollama". Part of the cache key so switching providers doesn't
  /// serve a stale artifact generated by a different model.
  provider String
  /// e.g. "llama3.1".
  model String

  /// The validated output (see src/lib/ai/storyBrief/schema.ts's
  /// AiStoryBriefOutput shape), JSON-encoded. Already passed every
  /// validation step before this row was ever written — never
  /// re-validated on read, only on write.
  outputJson String

  /// Foundation for future manual correction only, mirroring Phase 7/10's
  /// own reviewState precedent — no admin UI reads or writes this yet.
  reviewState String @default("UNREVIEWED")

  generatedAt DateTime @default(now())

  @@unique([storyClusterId, feature, inputFingerprint, promptVersion, provider, model])
  @@index([storyClusterId])
}

/// One row per user; notification channel toggles. Extend with new columns
/// (additive) as new notification types are added.
model NotificationPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailBreakingNews Boolean  @default(false)
  emailDailyDigest  Boolean  @default(false)
  emailStoryUpdates Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Minimal administrative mutation audit log (Veriqen Phase 13B)
//
// The admin system has exactly one shared password and no per-admin
// identity (see ARCHITECTURE.md's Phase 13 section) — this table does NOT
// solve that; it only answers "an authenticated administrator performed
// this mutation at this time," which is the smallest useful compensating
// control available without building real multi-admin identity. No
// adminId/session-identifier column exists because there is currently
// nothing meaningful to put in one.
// ---------------------------------------------------------------------------

/// One row per successfully committed admin mutation (never a read-only
/// page view, never an auth/CSRF/validation failure that never reached the
/// mutation itself — see src/lib/adminAudit.ts, the only writer of this
/// table). `summary` is ALWAYS a short, pre-built, call-site-authored
/// string — never a serialized request body, error object, or any other
/// value that could carry a secret, token, or raw user/publisher content;
/// this is what makes the table itself safe to add a read-only admin view
/// on top of. Retention is deliberately unmanaged in Phase 13B (no
/// scheduler, no cap enforcement beyond the read view's own bounded
/// query) — a real retention policy is deferred to a later phase, per
/// ARCHITECTURE.md.
model AdminAuditLog {
  id         String   @id @default(cuid())
  occurredAt DateTime @default(now())
  /// Stable dotted action key, e.g. "source.create", "settings.update.ai".
  action     String
  /// e.g. "Source", "Category" — omitted for actions with no single target (e.g. a bulk ingestion trigger).
  targetType String?
  targetId   String?
  /// Short, pre-redacted, human-readable description — see this model's own doc comment. Never a raw request body.
  summary    String
  success    Boolean  @default(true)

  @@index([occurredAt])
}
